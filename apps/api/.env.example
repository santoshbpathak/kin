# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Demo mode ───────────────────────────────────────────────────
# true  -> the AI layer is a deterministic offline script, no paid APIs,
#          no messages sent. The web app shows a "Demo mode" ribbon.
# false -> always use the real OpenAI client (fails if the key is missing).
# unset -> demo when OPENAI_API_KEY is missing outside production.
# See docs/development.md.
KIN_DEMO_MODE=

# ── Database ─────────────────────────────────────────────────────
# Use postgres for Supabase/PostgreSQL. Use sqljs for local-only API dev
# when Postgres/Docker is not installed (pnpm dev:local sets this for you).
DATABASE_DRIVER=sqljs
# IMPORTANT: in production (Vercel) use the Supabase TRANSACTION-mode pooler URL
# (port 6543), NOT the direct connection (port 5432). Pooler is mandatory for
# serverless because each function instance opens its own pool; the direct
# connection limit on free tier is 60 and serverless will saturate it quickly.
DATABASE_URL=postgresql://kin_user:kin_pass@localhost:5432/kin_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kin_db
DATABASE_USER=kin_user
DATABASE_PASS=kin_pass
DATABASE_SSL=false
# Verify the database TLS certificate (recommended: true in production).
# Provide DATABASE_SSL_CA (PEM, single line with \n) if your provider uses a
# private CA for direct connections.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_CA=
DATABASE_SQLJS_LOCATION=kin-local.sqlite
# Log every SQL query with bound parameters (contains phone numbers). Dev only.
DATABASE_LOG_QUERIES=false

# ── Auth ─────────────────────────────────────────────────────────
# Generate via: ./scripts/generate-secrets.sh  (32+ random bytes each)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=7d
VAULT_JWT_SECRET=change-me-vault-secret-min-32-chars
VAULT_JWT_EXPIRY=1h

# ── Supabase (Postgres + Storage) ────────────────────────────────
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# server-only - never bundle into the web client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_VAULT_BUCKET=kin-vault-documents

# ── WhatsApp Business Cloud API ───────────────────────────────────
# Leave empty to keep WhatsApp in sandbox mode (nothing is sent).
# Populate when Meta has approved your templates.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Random string you also paste into the Meta webhook settings. No default:
# an empty value disables the GET verification handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret, used to verify X-Hub-Signature-256 on inbound webhooks.
# Required in production; unsigned webhooks are rejected without it.
WHATSAPP_APP_SECRET=

# ── Partners / CORS ───────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API in production.
PARTNER_EMBED_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
VAULT_RATE_LIMIT_MAX=10

# ── Sentry (optional - enable later by setting DSN) ──────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── OpenAI (Module A: Conversational Diagnostic Engine) ──────────
# Required for the real AI diagnostic / advisor. Never log or expose this key.
# Leave as-is to run in demo mode locally.
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_ESCALATION=gpt-4o-mini
OPENAI_MAX_TOKENS_DIAGNOSTIC=2000
OPENAI_MAX_TOKENS_ADVISOR=1500
OPENAI_MAX_TOKENS_EXTRACTION=3000
# Session resumability window for in-flight diagnostic conversations (seconds)
CONVERSATION_TTL_SECONDS=1800
# Hard cap on user turns per diagnostic / advisor conversation (spend guard)
MAX_CONVERSATION_TURNS=40
