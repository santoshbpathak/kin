# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Use postgres for Supabase/PostgreSQL. Use sqljs for local-only API dev
# when Postgres/Docker is not installed.
DATABASE_DRIVER=postgres
# IMPORTANT: in production (Vercel) use the Supabase TRANSACTION-mode pooler URL
# (port 6543), NOT the direct connection (port 5432). Pooler is mandatory for
# serverless because each function instance opens its own pool; the direct
# connection limit on free tier is 60 and serverless will saturate it quickly.
DATABASE_URL=postgresql://kin_user:kin_pass@localhost:5432/kin_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kin_db
DATABASE_USER=kin_user
DATABASE_PASS=kin_pass
DATABASE_SSL=false
DATABASE_SQLJS_LOCATION=kin-local.sqlite

# ── Auth ─────────────────────────────────────────────────────────
# Generate via: ./scripts/generate-secrets.sh
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=7d
VAULT_JWT_SECRET=change-me-vault-secret-min-32-chars
VAULT_JWT_EXPIRY=1h

# ── Supabase (Postgres + Storage) ────────────────────────────────
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# server-only - never bundle into the web client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_VAULT_BUCKET=kin-vault-documents

# ── WhatsApp Business Cloud API ───────────────────────────────────
# Leave empty to keep WhatsApp in sandbox mode (OTPs printed to log).
# Populate when Meta has approved your templates.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Partners / CORS ───────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API in production.
# Production: include https://app.kin.ai.in
PARTNER_EMBED_ALLOWED_ORIGINS=http://localhost:5173,https://app.kin.ai.in

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
VAULT_RATE_LIMIT_MAX=10

# ── Sentry (optional - enable later by setting DSN) ──────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
