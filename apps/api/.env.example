# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://kin_user:kin_pass@localhost:5432/kin_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kin_db
DATABASE_USER=kin_user
DATABASE_PASS=kin_pass
DATABASE_SSL=false

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=7d
VAULT_JWT_SECRET=change-me-vault-secret-min-32-chars
VAULT_JWT_EXPIRY=1h

# ── AWS ──────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=kin-vault-documents
AWS_S3_PRESIGNED_URL_EXPIRY=900

# ── WhatsApp Business Cloud API ───────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Partners ─────────────────────────────────────────────────────
PARTNER_EMBED_ALLOWED_ORIGINS=http://localhost:5173,https://yourpartner.com

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
VAULT_RATE_LIMIT_MAX=10

# ── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=
