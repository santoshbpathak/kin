# ── KIN Web — Vite env vars ──────────────────────────────────────
#
# All Vite client-exposed vars must begin with VITE_. These end up in the
# bundle, so never put secrets here.

# Base URL the apiClient uses for backend calls.
# Local dev: leave unset (defaults to /api/v1, which the Vite dev server
# proxies to http://localhost:3001).
# Production: set to https://api.your-domain.example/api/v1 in your host's
# project settings.
VITE_API_BASE_URL=
